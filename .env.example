# =============================================================================
# Back To Travelling — environment variables
# =============================================================================
#
# This file is the contract. Every variable the server reads is declared and
# validated in server/_core/env.ts; if you add one there, add it here too.
#
# Local setup:
#   cp .env.example .env      # then fill in the values below
#
# Preferred setup (no secrets on disk):
#   doppler login && doppler setup && pnpm dev:doppler
#
# NEVER commit a real .env — it is git-ignored for a reason.
# See docs/runbooks/secrets.md and docs/runbooks/environments.md.
# =============================================================================

# --- Runtime ----------------------------------------------------------------
# Which environment this process represents: development | test | preview | production.
# Controls validation strictness, log format and log level.
APP_ENV=development
NODE_ENV=development
PORT=5000

# debug | info | warn | error | silent. Defaults to debug locally, info when deployed.
LOG_LEVEL=debug

# Public origin of the app; used to build magic-link and invite URLs, and to
# fix the WebAuthn relying party for passkeys.
# Leave empty locally — the request's own Host header is used instead. Deployed,
# set it: a passkey verified against an attacker-supplied Host header loses the
# phishing resistance that is the point of passkeys.
PUBLIC_BASE_URL=

# --- Database (one of these is required in preview/production) ----------------
# PostgreSQL connection string. Supabase: Project Settings -> Database -> URI.
# Local: postgresql://postgres@127.0.0.1:5432/back_to_travelling_dev
#
# When deploying serverless, use a POOLER host — Supabase:
# postgresql://postgres.<project-ref>:<pw>@aws-N-<region>.pooler.supabase.com:5432/postgres
# Each function instance holds its own pool, and the direct db.<ref>.supabase.co
# host is AAAA-only, which Vercel cannot reach (ENETUNREACH). Port 5432, the
# session pooler — not 6543; docs/runbooks/database.md explains why.
DATABASE_URL=

# Set automatically by the Supabase/Vercel integration. Used only when
# DATABASE_URL is unset: POSTGRES_URL first, then the non-pooling host. Do not
# rely on these on Vercel — this project's integration is the older style that
# points them at the direct, IPv6-only host, so they cannot connect. A value
# that is not a Postgres URL is ignored rather than used — /api/health reports
# which one won.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- Sessions (required in preview/production) -------------------------------
# Signs the session cookie. Must be >= 32 chars in a deployed environment.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Application identifier; also exposed to the client as VITE_APP_ID.
VITE_APP_ID=harmony

# openId of the account that should be granted the admin role on sign-in.
OWNER_OPEN_ID=

# --- AI provider (optional) --------------------------------------------------
# Powers the referee, natural-language date parsing, listing-URL import and
# accommodation matching. Without a key the app runs and those features return
# an error to the user.
#
# The KEY is what turns AI on. `server/_core/llm.ts` talks to Gemini through
# @google/genai, which already knows Google's endpoint — leave the base URL
# empty unless you are pointing it at a proxy or a gateway. /api/health reports
# `ai: configured` and names the variable the key came from.
AI_INTEGRATIONS_GEMINI_API_KEY=

# Which model to call. Empty uses the pinned default in server/_core/env.ts
# (`DEFAULT_AI_MODEL`), currently gemini-3.6-flash, verified against a real key.
#
# This is a variable because models are retired on the vendor's schedule, not
# ours: `gemini-2.5-flash` was hardcoded and quietly stopped accepting new
# callers, so every AI request 404'd while /api/health still said
# `ai: configured`. Moving to the next model is now an environment edit.
# Pinned rather than an alias like `gemini-flash-latest` on purpose — an alias
# changes which model answers without a deploy, which is the same surprise.
# List what a key can use:
#   curl -H "x-goog-api-key: $KEY" https://generativelanguage.googleapis.com/v1beta/models
AI_MODEL=

# Kill switch, independent of the key. Empty or unset means ON — so adding this
# variable to an environment that lacks it can never switch a working feature
# off by surprise. Only an explicit no disables: 0, false, no, off, disabled.
# Use it to stop calling the provider without deleting the credential.
# /api/health then reports `ai: off` rather than `missing`.
AI_ENABLED=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# Legacy Manus/Forge names; take precedence over the two above when set. Forge
# genuinely needs its URL — image generation, transcription and the data API
# call that gateway directly.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Email (optional) --------------------------------------------------------
# Providers are tried in order: Resend first, then SMTP — serverless platforms
# commonly block outbound SMTP ports. With neither, the app still works: magic
# links and invites are written to the log instead of being emailed, which is
# the intended local flow.
RESEND_API_KEY=

# The sender address. Resend will only deliver to the account owner while this
# is its shared sandbox sender, so set a verified domain before relying on
# magic links in production — the sign-in UI checks this and hides passwordless
# sign-in when mail cannot reach arbitrary recipients.
MAIL_FROM=

# Pins one provider when both are configured: "resend" or "smtp". Leave empty
# to try Resend then SMTP.
MAIL_PROVIDER=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Listing scraper fallback (optional, OFF by default) ----------------------
# Reads an accommodation listing through a third-party unblocking service, but
# only after the site has refused a plain fetch, and never when the traveller
# has pasted the page. Leave SCRAPER_PROVIDER empty and nothing changes: the
# import degrades through URL hints, a Google Places lookup and the paste box,
# exactly as ADR-0008 describes. See ADR-0013 for why this rung exists at all.
#
# The vendor's API key, and the only variable needed for the default setup.
# A secret: Doppler/Vercel only, never a value in git.
SCRAPER_API_KEY=

# Kill switch, independent of the key — same rules as AI_ENABLED above: empty
# or unset means ON, and only 0/false/no/off/disabled turns it off. This rung
# bills per request, so being able to pause the spend without deleting a paid
# key is the point. /api/health then reports `scraper: off`, which is a
# different answer from `disabled` (no key was ever set).
SCRAPER_ENABLED=

# Which service. Defaults to `scrapingowl` when a key is set and this is empty.
# Presets: scrapingowl | scrapingbee | scraperapi | zenrows | scrapfly |
#          scrapingant | scrapingdog | crawlbase | zyte | custom.
#
# Write the vendor however its dashboard writes it. The name is reduced to the
# vendor before lookup, so `ScraperAPI`, `scraper-api`, `scraperapi.com` and
# `https://api.scraperapi.com/` are all the same preset. `none` switches the
# rung off while leaving the key in place.
#
# A vendor with no preset needs no code change either: set SCRAPER_ENDPOINT and
# the fields below, with or without a name for it. Switching vendor is an
# environment edit, always.
SCRAPER_PROVIDER=

# Overrides. Each one replaces the chosen preset's value; leave empty to keep
# the preset. For a vendor with no preset, SCRAPER_ENDPOINT is the one that
# matters — the rest default to the common shape (key and URL in the query).
#   SCRAPER_ENDPOINT      https://api.example.com/v1/scrape
#   SCRAPER_METHOD        GET | POST
#   SCRAPER_URL_PARAM     name of the parameter carrying the listing URL
#   SCRAPER_API_KEY_PARAM name of the parameter/header carrying the key
#   SCRAPER_API_KEY_IN    query | header | body | basic
#                         `basic` is HTTP Basic with the key as the username
#   SCRAPER_RENDER_PARAM  what this vendor calls "run the page's JavaScript",
#                         or `none` when it has no such flag
#   SCRAPER_HTML_PATH     dotted path to the HTML in a JSON reply, or `none`
#                         when the response body is already the page
SCRAPER_ENDPOINT=
SCRAPER_METHOD=
SCRAPER_URL_PARAM=
SCRAPER_API_KEY_PARAM=
SCRAPER_API_KEY_IN=
SCRAPER_RENDER_PARAM=
SCRAPER_HTML_PATH=

# Extra parameters the service takes, as `a=b&c=d` or a JSON object when a
# value contains characters a query string would mangle. Example:
#   SCRAPER_PARAMS=country=nl&premium_proxies=true
SCRAPER_PARAMS=

# Run the page's JavaScript. Default true — Airbnb is a JS shell and renders to
# nothing without it. Costs more per request on most plans.
SCRAPER_RENDER_JS=

# Per-request budget, milliseconds. Rendering is slow; 30s is the default.
SCRAPER_TIMEOUT_MS=

# Spend the quota only on these hosts (comma-separated, subdomains included).
# Empty means every host that blocks us. Example:
#   SCRAPER_HOSTS=booking.com,airbnb.com,expedia.com
SCRAPER_HOSTS=

# --- OAuth (legacy Manus portal — DEAD, leave both empty) --------------------
# Removed from every environment on 2026-08-10. `getLoginUrl()` in
# client/src/const.ts is exported and never called, so nothing in the UI has
# ever reached the portal, and OAUTH_SERVER_URL only feeds an
# /api/oauth/callback route nothing links to. Email+password, magic-link and
# passkey sign-in do not use either.
#
# They are still declared because the code that reads them is still present;
# removing that code is a separate change, because sdk.ts also carries the live
# session path. Setting them would switch a dead flow back on — don't.
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
