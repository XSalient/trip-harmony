{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "WeVoTrip",

  // Same Node major as CI and Vercel, so "works on my machine" means something.
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/doppler-cli:1": {}
  },

  // No database is bundled: point DATABASE_URL at a hosted Postgres (Supabase,
  // Neon) or run one locally — see docs/runbooks/local-setup.md.
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": { "label": "WeVoTrip app", "onAutoForward": "notify" }
  },

  "postCreateCommand": "corepack enable && pnpm install",

  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "bradlc.vscode-tailwindcss"],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },

  "remoteUser": "node"
}
